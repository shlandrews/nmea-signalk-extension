{
  "manifest_version": 3,
  "name": "Marine GPS Geolocation",
  "version": "2.0.0",
  "minimum_chrome_version": "116",
  "description": "Standalone marine GPS geolocation using direct Signal K and NMEA WebSockets.",
  "permissions": ["storage", "offscreen", "alarms", "activeTab"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_popup": "popup.html", "default_icon": "icon.png"},
  "icons": {"128": "icon.png"},
  "content_scripts": [
    {"matches": ["http://*/*", "https://*/*"], "js": ["geolocation.js"], "run_at": "document_start", "world": "MAIN", "all_frames": true, "match_origin_as_fallback": true},
    {"matches": ["http://*/*", "https://*/*"], "js": ["relay.js"], "run_at": "document_start", "all_frames": true, "match_origin_as_fallback": true}
  ]
}
